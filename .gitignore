# macOS Finder metadata. One already exists in this directory, which is why this
# file had to land before the first commit. No leading slash, so it matches at
# any depth.
.DS_Store

# Python bytecode, regenerated on every run. Committing it creates noise diffs
# and can shadow edited source.
__pycache__/
*.pyc

# Virtual environments. Rebuilt from a pinned requirements file, never shared --
# they contain absolute paths and compiled binaries for one machine.
venv/
.venv/

# Secrets, unconditionally. AWS credentials live in ~/.aws-personal/credentials
# and must never reach a commit; history is far harder to clean than a working
# tree.
.env
*.pem

# AgentCore build artifacts. `agentcore configure` and `agentcore deploy` write
# here, and a single cached dependencies.zip is ~50 MB. Both were committed by
# mistake and purged from history on 2026-08-29; this stops them returning.
.bedrock_agentcore/

# AgentCore per-project config. Regenerated by `agentcore configure`, and it
# records absolute local paths, the AWS account id and role ARNs.
.bedrock_agentcore.yaml

# Chat transcripts. Worth keeping locally as a record of how a lab went, but they
# carry account ids, ARNs and the whole working narrative -- not for publishing.
.kiro/chats/
